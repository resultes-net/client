PUBLIC_API_BASE_URI=http://localhost:5173/api

# Use `kubectl port-forward -n server service/external-server 9000:8080` to port-forward.
# Then, use the default entry of the `ip route` output to find the IP address for the
# line below.
#PUBLIC_API_PROXY_TARGET=http://127.20.64.1:8080
# Or go straight to 
#PUBLIC_API_PROXY_TARGET=https://dev.resultes.net
#PUBLIC_API_PROXY_REMOVE_PREFIX=false

PUBLIC_API_PROXY_TARGET=http://localhost:8080
PUBLIC_API_PROXY_REMOVE_PREFIX=true
